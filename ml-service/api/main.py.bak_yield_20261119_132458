import json
import logging
from pathlib import Path
from datetime import datetime, timezone
from typing import Any

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

from model_registry import (
MODEL_PATH = os.path.join(os.path.dirname(os.path.dirname(__file__)), "models", "yield_model.pkl")
    get_production_models
)

from prediction import predict_seed_quantity, predict_seed_quantity_candidate, InvalidInputError

BASE_DIR = Path(__file__).resolve().parent.parent
REPORTS_DIR = BASE_DIR / "reports"
EVALUATION_REPORT = REPORTS_DIR / "evaluation_report.json"

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("AFIP_API")

app = FastAPI(
    title="AFIP - Agricultural Forecasting and Intelligence Platform",
    description="Agricultural Machine Learning API",
    version="1.0.0"
)


class SeedQuantityRequest(BaseModel):
    features: dict[str, Any] = Field(
        ...,
        description="Features required by the seed quantity model"
    )


@app.get("/")
def root():
    return {
        "platform": "AFIP",
        "version": "1.0.0",
        "status": "running",
        "documentation": "/docs"
    }


@app.get("/health")
def health():
    return {
        "status": "healthy",
        "timestamp": datetime.now(timezone.utc).isoformat()
    }


@app.get("/models")
def models():
    registry = list_models()

    return {
        "models": registry["models"],
        "production_ready_count": len(get_production_models())
    }


@app.get("/evaluation")
def evaluation():
    if not EVALUATION_REPORT.exists():
        raise HTTPException(
            status_code=404,
            detail="Evaluation report not found."
        )

    with open(
        EVALUATION_REPORT,
        "r",
        encoding="utf-8"
    ) as file:
        return json.load(file)


