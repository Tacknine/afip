        "raw_data_modified": False
    }


@app.post("/predict/seed-quantity")
def seed_quantity_prediction(request: SeedQuantityRequest):

    if "seed_quantity" not in get_production_models():
        raise HTTPException(
            status_code=409,
            detail={
                "message": "Model is not approved for production.",
                "status": "requires_review"
            }
        )

    try:
        result = predict_seed_quantity(request.features)

        return {
            "model": "seed_quantity",
            "prediction_status": "success",
            "prediction": result,
            "timestamp": datetime.now(timezone.utc).isoformat()
        }

    except (InvalidInputError, ValueError, RuntimeError) as error:
        raise HTTPException(
            status_code=400,
            detail=str(error)
        ) from error

    except Exception as error:
        logger.exception("Prediction failed.")

        raise HTTPException(
            status_code=500,
            detail="Internal prediction error."
        ) from error


@app.post("/predict/seed-quantity/research")
def research_seed_quantity(request: SeedQuantityRequest):

    model_info = list_models()["models"]["seed_quantity"]

    if not model_info["available"]:
        raise HTTPException(
            status_code=404,
            detail="Seed quantity model is unavailable."
        )

    try:
        result = predict_seed_quantity(request.features)

        return {
            "model": "seed_quantity",
            "prediction_status": "research_only",
            "production_approved": False,
            "warning": (
                "Experimental prediction. Do not use "
                "for real agricultural decisions."
            ),
            "prediction": result,
            "timestamp": datetime.now(timezone.utc).isoformat()
        }

    except (InvalidInputError, ValueError, RuntimeError) as error:
        raise HTTPException(
            status_code=400,
            detail=str(error)
        ) from error

    except Exception as error:
        logger.exception("Research prediction failed.")

        raise HTTPException(
            status_code=500,
            detail="Research prediction failed."
        ) from error



